{
    "name":  "schema2md-cli",
    "version":  "0.3.0",
    "description":  "Generate Markdown/LaTeX + Mermaid ER (CLI for DB schemas)",
    "private":  false,
    "type":  "commonjs",
    "bin":  {
                "db-doc":  "dist/cli.js"
            },
    "scripts":  {
                    "build":  "tsc",
                    "start":  "node dist/cli.js",
                    "clean":  "node -e \"require(\u0027fs\u0027).rmSync(\u0027dist\u0027,{recursive:true,force:true})\"",
                    "prepublishOnly":  "npm run build"
                },
    "dependencies":  {
                         "sql.js":  "^1.9.0",
                         "pg":  "^8.11.5",
                         "mysql2":  "^3.11.0"
                     },
    "devDependencies":  {
                            "typescript":  "^5.4.0",
                            "@types/node":  "^20.11.30"
                        },
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  ""
                   },
    "files":  [
                  "dist",
                  "README.md",
                  "LICENSE"
              ],
    "engines":  {

                },
    "homepage":  "https://github.com/Maxenceboo/schema2md#readme",
    "bugs":  {
                 "url":  "https://github.com/Maxenceboo/schema2md/issues"
             },
    "keywords":  [
                     "database",
                     "schema",
                     "markdown",
                     "mermaid",
                     "er",
